{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "type": {
      "enum": [
        "WorkbenchRequest",
        "WorkbenchSnapshot",
        "WorkbenchMonitorRequest",
        "WorkbenchMonitorSnapshot",
        "WorkbenchPositionsRequest",
        "WorkbenchPositionsSnapshot"
      ]
    },
    "message_id": {
      "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
    },
    "connection_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "sent_at_utc": {
      "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/utc"
    },
    "kernel_boot_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "account_key": {
      "anyOf": [
        {
          "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {}
  },
  "required": [
    "protocol_version",
    "type",
    "message_id",
    "connection_id",
    "correlation_id",
    "sent_at_utc",
    "kernel_boot_id",
    "account_key",
    "body"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.onlinetrader.invalid/dev18/workbench-ipc.schema.json",
  "title": "Read-only workbench extension; no inbound broker facts",
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "type": {"const": "WorkbenchPositionsRequest"},
            "body": {
              "type": "object",
              "required": ["after"],
              "additionalProperties": false,
              "properties": {
                "after": {"anyOf": [{"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"}, {"type": "null"}]}
              }
            }
          }
        },
        {
          "properties": {
            "type": {"const": "WorkbenchPositionsSnapshot"},
            "body": {
              "type": "object",
              "required": ["payload", "content_hash"],
              "additionalProperties": false,
              "properties": {
                "content_hash": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/hash"},
                "payload": {
                  "type": "object",
                  "required": ["account_key", "kernel_boot_id", "checkpoint_event_seq", "positions", "has_more"],
                  "additionalProperties": false,
                  "properties": {
                    "account_key": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                    "kernel_boot_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                    "checkpoint_event_seq": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"},
                    "has_more": {"type": "boolean"},
                    "positions": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "required": ["position_cycle_id", "contract_id", "direction", "remaining_quantity"],
                        "additionalProperties": false,
                        "properties": {
                          "position_cycle_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                          "contract_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                          "direction": {"enum": ["LONG", "SHORT"]},
                          "remaining_quantity": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/positiveQuantity"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {"const": "WorkbenchMonitorRequest"},
            "body": {"type": "object", "maxProperties": 0}
          }
        },
        {
          "properties": {
            "type": {"const": "WorkbenchMonitorSnapshot"},
            "body": {
              "type": "object",
              "required": ["payload", "content_hash"],
              "additionalProperties": false,
              "properties": {
                "content_hash": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/hash"},
                "payload": {
                  "type": "object",
                  "required": ["account_key", "kernel_boot_id", "checkpoint_event_seq", "sample_at_utc",
                               "quote_delay_seconds", "quote_status", "symbols", "diagnostics"],
                  "additionalProperties": false,
                  "properties": {
                    "account_key": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                    "kernel_boot_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                    "checkpoint_event_seq": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"},
                    "sample_at_utc": {
                      "anyOf": [{"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/utc"}, {"type": "null"}]
                    },
                    "quote_delay_seconds": {
                      "type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]+)?$", "maxLength": 32
                    },
                    "quote_status": {"enum": ["等待行情", "连接中", "正常", "延迟", "无行情", "休市", "未知"]},
                    "symbols": {"type": "array", "maxItems": 64, "items": {"type": "object", "maxProperties": 12}},
                    "diagnostics": {
                      "type": ["object", "null"],
                      "properties": {
                        "snapshot_at_utc": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/utc"},
                        "snapshot_monotonic_ns": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"},
                        "source_epoch": {"type": ["integer", "null"], "minimum": 1},
                        "trading_day": {"type": ["string", "null"], "format": "date"},
                        "ticks": {"type": "array", "maxItems": 128, "items": {"type": "object", "maxProperties": 13}},
                        "symbols": {"type": "array", "maxItems": 64, "items": {"type": "object", "maxProperties": 4}}
                      },
                      "required": ["snapshot_monotonic_ns", "ticks"],
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "WorkbenchRequest"
            },
            "body": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "WorkbenchSnapshot"
            },
            "body": {
              "type": "object",
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "view_schema": {
                      "const": "workbench/1"
                    },
                    "account_key": {
                      "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
                    },
                    "kernel_boot_id": {
                      "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"
                    },
                    "checkpoint_event_seq": {
                      "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"
                    },
                    "entry_authority": {
                      "enum": [
                        "ARMED",
                        "DISARMED"
                      ]
                    },
                    "execution_scope": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "connection": {
                      "type": "object"
                    },
                    "configuration": {
                      "type": "object"
                    },
                    "account_display": {
                      "type": "object",
                      "required": ["provider", "masked_login", "alias"],
                      "additionalProperties": false,
                      "properties": {
                        "provider": {"type": "string", "maxLength": 64},
                        "masked_login": {"type": "string", "maxLength": 256},
                        "alias": {"type": "string", "maxLength": 256}
                      }
                    },
                    "config_snapshot": {
                      "type": "object",
                      "required": [
                        "schema_version", "account_key", "kernel_boot_id", "config_revision",
                        "payload_hash", "rule_set_id", "profile_hash", "effective_boundary",
                        "created_event_seq", "effective_at_utc", "decision_inputs", "integrity", "errors"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "schema_version": {"const": "ONLINE_TRADER_CONFIG_SNAPSHOT/1"},
                        "account_key": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                        "kernel_boot_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                        "config_revision": {"type": "string", "maxLength": 256},
                        "payload_hash": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/hash"},
                        "rule_set_id": {"type": "string", "maxLength": 256},
                        "profile_hash": {
                          "oneOf": [
                            {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/hash"},
                            {"type": "null"}
                          ]
                        },
                        "effective_boundary": {"type": ["string", "null"], "maxLength": 256},
                        "created_event_seq": {
                          "oneOf": [
                            {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"},
                            {"type": "null"}
                          ]
                        },
                        "effective_at_utc": {"type": ["string", "null"], "maxLength": 64},
                        "decision_inputs": {
                          "type": "object",
                          "maxProperties": 16,
                          "additionalProperties": {"type": ["string", "integer", "null"], "maxLength": 256}
                        },
                        "integrity": {"enum": ["VERIFIED", "INVALID"]},
                        "errors": {
                          "type": "array",
                          "maxItems": 32,
                          "items": {"type": "string", "maxLength": 128}
                        }
                      }
                    },
                    "capabilities": {
                      "type": "object",
                      "required": ["revision", "observed_at_utc", "operations"],
                      "additionalProperties": false,
                      "properties": {
                        "revision": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"},
                        "observed_at_utc": {"type": "string", "maxLength": 64},
                        "operations": {
                          "type": "array",
                          "maxItems": 64,
                          "items": {
                            "type": "object",
                            "required": ["operation", "scope_type", "allowed", "reason"],
                            "additionalProperties": false,
                            "properties": {
                              "operation": {"type": "string", "maxLength": 64},
                              "scope_type": {"type": "string", "maxLength": 64},
                              "allowed": {"type": "boolean"},
                              "reason": {"type": ["string", "null"], "maxLength": 256}
                            }
                          }
                        }
                      }
                    },
                    "diagnostics": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "object",
                        "maxProperties": 20,
                        "required": [
                          "diagnostic_version", "code", "reason", "kind", "category", "severity",
                          "source", "operation", "command_id", "trace_id", "impact_scope",
                          "recovery_state", "retry_policy", "occurred_at", "context"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "diagnostic_version": {"type": "integer", "minimum": 1},
                          "code": {"type": "string", "maxLength": 64},
                          "reason": {"type": "string", "maxLength": 256},
                          "kind": {"type": "string", "maxLength": 64},
                          "category": {"type": "string", "maxLength": 64},
                          "severity": {"type": "string", "maxLength": 64},
                          "source": {"type": "string", "maxLength": 64},
                          "operation": {"type": ["string", "null"], "maxLength": 64},
                          "command_id": {"type": ["string", "null"], "maxLength": 256},
                          "trace_id": {"type": ["string", "null"], "maxLength": 512},
                          "impact_scope": {"type": "string", "maxLength": 64},
                          "recovery_state": {"type": "string", "maxLength": 64},
                          "retry_policy": {"type": "string", "maxLength": 128},
                          "occurred_at": {"type": ["string", "null"], "maxLength": 64},
                          "context": {"type": "object", "maxProperties": 16}
                        }
                      }
                    },
                    "contract_catalog": {
                      "type": "object",
                      "required": ["revision", "observed_at_utc", "complete", "source", "contracts"],
                      "additionalProperties": false,
                      "properties": {
                        "revision": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/seq"},
                        "observed_at_utc": {"type": "string", "maxLength": 64},
                        "complete": {"type": "boolean"},
                        "source": {"type": "string", "maxLength": 128},
                        "contracts": {
                          "type": "array",
                          "maxItems": 4096,
                          "items": {"type": "string", "maxLength": 128}
                        }
                      }
                    },
                    "account_metrics": {
                      "type": "object",
                      "maxProperties": 16
                    },
                    "equity_history": {
                      "type": "array",
                      "maxItems": 512,
                      "items": {"type": "object", "maxProperties": 4}
                    },
                    "minute_bars": {
                      "type": "object",
                      "maxProperties": 64,
                      "additionalProperties": {
                        "type": "array",
                        "maxItems": 48,
                        "items": {
                          "type": "array",
                          "minItems": 5,
                          "maxItems": 5,
                          "prefixItems": [{"type": "integer", "minimum": 1}],
                          "items": {"type": "string", "maxLength": 32}
                        }
                      }
                    },
                    "symbol_entry_switches": {
                      "type": "object",
                      "maxProperties": 512
                    },
                    "markets": {
                      "type": "array",
                      "maxItems": 512,
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "external_positions": {
                      "type": "array",
                      "items": {"type": "object", "maxProperties": 64}
                    },
                    "cycles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "orders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "trades": {
                      "type": "array",
                      "maxItems": 512,
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "blocks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "policies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "maxProperties": 64
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "history_truncated": {"type": "boolean"},
                    "history_omitted": {
                      "type": "object",
                      "propertyNames": {"enum": ["cycles", "orders", "trades", "commands", "minute_bars"]},
                      "additionalProperties": {"type": "integer", "minimum": 0}
                    },
                    "status_projection": {
                      "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/projectionBatch"
                    },
                    "detail_unavailable": {"const": "CURRENT_STATE_OVERSIZE"},
                    "detail_omitted": {
                      "type": "object",
                      "propertyNames": {"enum": ["cycles", "orders", "trades", "markets", "blocks", "commands", "external_positions"]},
                      "additionalProperties": {"type": "integer", "minimum": 0}
                    },
                    "current_responsibility": {
                      "type": "object",
                      "required": ["cycles", "owned_quantity", "active_orders"],
                      "additionalProperties": false,
                      "properties": {
                        "cycles": {"type": "integer", "minimum": 0},
                        "owned_quantity": {"type": "integer", "minimum": 0},
                        "active_orders": {"type": "integer", "minimum": 0}
                      }
                    },
                    "runtime_mode": {
                      "enum": ["MONITORING", "TRADING", "DRAINING"]
                    },
                    "strategy_intent": {
                      "enum": ["STOPPED", "RUNNING"]
                    },
                    "responsibility": {
                      "type": "object",
                      "required": [
                        "state", "protected_lots_total", "unresolved_children",
                        "unresolved_convergence_cancels", "conflict_contracts",
                        "preview_only_contracts", "blockers", "maintenance_allowed"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "state": {"enum": ["NONE", "ACTIVE", "DRAINING", "UNKNOWN"]},
                        "protected_lots_total": {"type": "integer", "minimum": 0},
                        "unresolved_children": {"type": "integer", "minimum": 0},
                        "unresolved_convergence_cancels": {"type": "integer", "minimum": 0},
                        "conflict_contracts": {
                          "type": "array", "maxItems": 64,
                          "items": {"type": "string", "maxLength": 128}
                        },
                        "preview_only_contracts": {
                          "type": "array", "maxItems": 64,
                          "items": {"type": "string", "maxLength": 128}
                        },
                        "blockers": {
                          "type": "array", "maxItems": 32,
                          "items": {"type": "string", "maxLength": 64}
                        },
                        "maintenance_allowed": {"type": "boolean"}
                      }
                    },
                    "maintenance": {
                      "type": ["object", "null"],
                      "required": ["command_id", "reason", "state"],
                      "additionalProperties": false,
                      "properties": {
                        "command_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                        "reason": {"enum": ["SWITCH_ACCOUNT", "UPDATE", "RESTART_CONFIG"]},
                        "state": {"enum": ["REQUESTED", "VERIFYING", "COMPLETED", "ABORTED"]}
                      }
                    },
                    "maintenance_completion": {
                      "type": ["object", "null"],
                      "required": ["command_id", "reason", "state", "blockers", "completed_at_utc"],
                      "additionalProperties": false,
                      "properties": {
                        "command_id": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/id"},
                        "reason": {"enum": ["SWITCH_ACCOUNT", "UPDATE", "RESTART_CONFIG"]},
                        "state": {"enum": ["COMPLETED", "ABORTED"]},
                        "blockers": {
                          "type": "array", "maxItems": 32,
                          "items": {"type": "string", "maxLength": 64}
                        },
                        "completed_at_utc": {"$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/utc"}
                      }
                    },
                    "config_recovery_notice": {
                      "type": ["object", "null"],
                      "required": ["state", "message", "apply_id"],
                      "additionalProperties": false,
                      "properties": {
                        "state": {"enum": ["MATCHES_OLD", "MATCHES_NEW", "HASH_CONFLICT", "CORRUPTED"]},
                        "message": {"type": "string", "maxLength": 512},
                        "apply_id": {"type": ["string", "null"], "maxLength": 128}
                      }
                    }
                  },
                  "required": [
                    "view_schema",
                    "account_key",
                    "kernel_boot_id",
                    "checkpoint_event_seq",
                    "entry_authority",
                    "execution_scope",
                    "connection",
                    "configuration",
                    "markets",
                    "cycles",
                    "orders",
                    "trades",
                    "blocks",
                    "commands",
                    "policies",
                    "truncated"
                  ],
                  "additionalProperties": false
                },
                "content_hash": {
                  "$ref": "https://schemas.onlinetrader.invalid/g0/ipc.schema.json#/$defs/hash"
                }
              },
              "required": [
                "payload",
                "content_hash"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ]
}
