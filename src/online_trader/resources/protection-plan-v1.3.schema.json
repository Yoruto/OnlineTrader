{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onlinetrader.invalid/simulation/protection-plan-v1.3.schema.json",
  "title": "OnlineTrader DSV ONLINE_SIMULATION ProtectionPlan 1.3",
  "description": "DSV 1.2 algorithms with a separate finite strategy grant; no manual grant escalation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_revision",
    "account_key",
    "position_cycle_id",
    "contract_id",
    "trading_day",
    "direction",
    "theoretical_entry_price",
    "initial_open_quantity",
    "rule_set_id",
    "config_revision",
    "config_hash",
    "execution_scope",
    "approval_record_id",
    "market_quality_policy_id",
    "price_field",
    "fixed_stop_loss",
    "fixed_take_profit",
    "profit_protection",
    "trailing_stop",
    "partial_reduction",
    "close_session",
    "slippage_exit",
    "data_gap_exit",
    "emergency_exit",
    "execution_policy",
    "online_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "plan_id": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/plan_id"
    },
    "plan_revision": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/plan_revision"
    },
    "account_key": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/account_key"
    },
    "position_cycle_id": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/position_cycle_id"
    },
    "contract_id": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/contract_id"
    },
    "trading_day": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/trading_day"
    },
    "direction": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/direction"
    },
    "theoretical_entry_price": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/theoretical_entry_price"
    },
    "initial_open_quantity": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/initial_open_quantity"
    },
    "rule_set_id": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/rule_set_id"
    },
    "config_revision": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/config_revision"
    },
    "config_hash": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/config_hash"
    },
    "execution_scope": {
      "const": "ONLINE_SIMULATION"
    },
    "approval_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "market_quality_policy_id": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/market_quality_policy_id"
    },
    "price_field": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/price_field"
    },
    "fixed_stop_loss": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/fixed_stop_loss"
    },
    "fixed_take_profit": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/fixed_take_profit"
    },
    "profit_protection": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/profit_protection"
    },
    "trailing_stop": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/trailing_stop"
    },
    "partial_reduction": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/partial_reduction"
    },
    "close_session": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/close_session"
    },
    "slippage_exit": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/slippage_exit"
    },
    "data_gap_exit": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/data_gap_exit"
    },
    "emergency_exit": {
      "$ref": "https://schemas.onlinetrader.invalid/development/protection-plan-v1.1.schema.json#/properties/emergency_exit"
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "first_price_mode",
        "cancel_check_interval_ms",
        "max_child_order_attempts",
        "price_steps",
        "close_offset_policy_id",
        "algorithm",
        "entry_confirm_timeout_ms",
        "passive_entry_first",
        "chase_window_ms",
        "passive_wait_ms",
        "close_retry_ms",
        "extra_tick_remaining_ms",
        "exchange_limit_remaining_ms",
        "force_retry_ms",
        "passive_ttl_ms",
        "aggr_ttl_ms",
        "market_ttl_ms",
        "cap_ttl_ms",
        "entry_slip_ratio",
        "chase_slip_ratio",
        "open_offset"
      ],
      "properties": {
        "policy_id": {
          "$ref": "https://schemas.onlinetrader.invalid/g0/protection-plan.schema.json#/$defs/id"
        },
        "first_price_mode": {
          "enum": [
            "OPPONENT_LIMIT",
            "PASSIVE_LIMIT"
          ]
        },
        "cancel_check_interval_ms": {
          "const": 3000
        },
        "max_child_order_attempts": {
          "const": null
        },
        "price_steps": {
          "type": "array",
          "maxItems": 0
        },
        "close_offset_policy_id": {
          "$ref": "https://schemas.onlinetrader.invalid/g0/protection-plan.schema.json#/$defs/id"
        },
        "algorithm": {
          "const": "DSV_TARGET_POSITION"
        },
        "entry_confirm_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "passive_entry_first": {
          "type": "boolean"
        },
        "chase_window_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "passive_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "close_retry_ms": {
          "const": 3000
        },
        "extra_tick_remaining_ms": {
          "const": 10000
        },
        "exchange_limit_remaining_ms": {
          "const": 5000
        },
        "force_retry_ms": {
          "const": 5000
        },
        "passive_ttl_ms": {
          "const": 90000
        },
        "aggr_ttl_ms": {
          "const": 60000
        },
        "market_ttl_ms": {
          "const": 120000
        },
        "cap_ttl_ms": {
          "const": 90000
        },
        "entry_slip_ratio": {
          "oneOf": [
            {
              "const": "0"
            },
            {
              "$ref": "https://schemas.onlinetrader.invalid/g0/protection-plan.schema.json#/$defs/ratio"
            }
          ]
        },
        "chase_slip_ratio": {
          "oneOf": [
            {
              "const": "0"
            },
            {
              "$ref": "https://schemas.onlinetrader.invalid/g0/protection-plan.schema.json#/$defs/ratio"
            }
          ]
        },
        "open_offset": {
          "$ref": "https://schemas.onlinetrader.invalid/g0/protection-plan.schema.json#/$defs/positive_decimal"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passive_entry_first": {
                "const": true
              }
            },
            "required": [
              "passive_entry_first"
            ]
          },
          "then": {
            "properties": {
              "first_price_mode": {
                "const": "PASSIVE_LIMIT"
              }
            }
          },
          "else": {
            "properties": {
              "first_price_mode": {
                "const": "OPPONENT_LIMIT"
              }
            }
          }
        }
      ]
    },
    "online_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_hash",
        "profile_hash",
        "calendar_hash"
      ],
      "properties": {
        "grant_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calendar_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
